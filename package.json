{
  "name": "xr-sandbox",
  "productName": "XR Technology Sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Offline interactive laboratory for understanding XR systems, architecture, and applications.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:dir": "electron-vite build && electron-builder --dir --config build/electron-builder.yml",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "size-check": "node scripts/size-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "baseline": "node scripts/baseline.mjs",
    "gate:0": "node scripts/gate-0.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@types/node": "24.13.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.1",
    "typescript": "5.4.5",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
